# Legacy Nginx: the only Nginx that clients talk to.
# It decides, per request, whether to proxy back to itself (:8080)
# or to the separate New Nginx process (:8082).
worker_processes 1;
pid /run/split/legacy.pid;
error_log /var/log/split/legacy-error.log warn;

events {
    worker_connections 512;
}

http {
    access_log off;

    log_format front escape=json '{"t":"$msec","nginx":"legacy","hop":"front door","port":"$server_port","request_id":"$request_id","uri":"$request_uri","status":"$status","split_target":"$split_target","route":"$route","upstream_addr":"$upstream_addr","upstream_status":"$upstream_status","request_time":"$request_time","client":"$remote_addr"}';
    log_format hop escape=json '{"t":"$msec","nginx":"legacy","hop":"self loop","port":"$server_port","request_id":"$http_x_request_id","uri":"$request_uri","status":"$status","request_time":"$request_time","peer":"$remote_addr"}';

    limit_req_zone $binary_remote_addr zone=api:1m rate=5r/s;
    limit_req_zone $binary_remote_addr zone=hits:1m rate=100r/s;
    limit_req_status 429;

    upstream new_nginx {
        server 127.0.0.1:8082;      # the New Nginx (a separate process)
    }

    upstream legacy_nginx {
        server 127.0.0.1:8080;      # this same Nginx (loops back to itself)
    }

    # ---- editable section: visitors can change this part ----
@@EDITABLE@@
    # ---- end of editable section ----

    # Front door: what the client connects to.
    server {
        listen @@PORT@@;

        set_real_ip_from 0.0.0.0/0;
        real_ip_header X-Forwarded-For;
        real_ip_recursive on;

        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 2s;

        # Tell the browser what Nginx decided.
        add_header X-Request-Id $request_id always;
        add_header X-Split-Target $split_target always;
        add_header X-Route $route always;
        add_header X-Upstream-Addr $upstream_addr always;
        add_header X-Upstream-Status $upstream_status always;
        add_header X-Client-Addr $remote_addr always;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Headers "Content-Type, X-Canary, X-User" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Expose-Headers "X-Request-Id, X-Split-Target, X-Route, X-Upstream-Addr, X-Upstream-Status, X-Client-Addr" always;
        add_header Access-Control-Max-Age 86400 always;
        add_header Cache-Control no-store always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        location = /healthz {
            return 200 "ok\n";
        }

        # Control API (reads and rewrites the editable section above).
        location /api/ {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://127.0.0.1:9000;
        }

        location / {
            limit_req zone=hits burst=300 nodelay;
            access_log /var/log/split/legacy-access.log front;

            proxy_pass http://$route;
            error_page 502 503 504 = @legacy;   # New Nginx down -> fall back
        }

        location @legacy {
            access_log /var/log/split/legacy-access.log front;
            proxy_pass http://legacy_nginx;
        }
    }

    # Legacy application: same Nginx process, reached through the loopback.
    server {
        listen 127.0.0.1:8080;
        access_log /var/log/split/legacy-access.log hop;

        location / {
            default_type application/json;
            return 200 '{"served_by":"legacy_nginx","port":"$server_port","request_id":"$http_x_request_id","x_forwarded_for":"$http_x_forwarded_for"}';
        }
    }
}
